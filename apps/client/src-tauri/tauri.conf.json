{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpareLine",
  "identifier": "app.spareline.client",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpareLine",
        "width": 1200,
        "height": 780,
        "minWidth": 420,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "publisher": "SpareLine",
    "category": "Business",
    "shortDescription": "Backup chat for when your usual tools go down",
    "longDescription": "SpareLine keeps your organisation talking during an outage. It connects to your own SpareLine Server on the office network; messages are end-to-end encrypted.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
