{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpareLine Server",
  "version": "0.1.0",
  "identifier": "app.spareline.server",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpareLine Server",
        "width": 1280,
        "height": 820,
        "minWidth": 420,
        "minHeight": 540,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "publisher": "SpareLine",
    "category": "Business",
    "shortDescription": "Run your organisation's SpareLine backup chat server",
    "longDescription": "SpareLine Server runs on one office computer. It sets itself up on first launch, finds clients on the LAN and relays end-to-end encrypted messages. The control panel manages invites, people and groups, and shows health and logs.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}